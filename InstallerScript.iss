; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only.

#define MyAppName "MyGit"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "Ngb0ss"
#define MyAppURL "https://github.com"
#define MyAppExeName "MyGit.exe"
#define EscapeConstArgument(Value) StringChange(StringChange(StringChange(Value, "%", "%25"), ",", "%2c"), "}", "%7d")

[Setup]
AppId={{A2E0FBEA-A443-4248-AFA9-298161932D7B}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
OutputDir=Z:\MyProjects_2026\MyGit
OutputBaseFilename=MyGitSetup
SolidCompression=yes
WizardStyle=modern dark polar

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl"

[Files]
Source: "Z:\MyProjects_2026\MyGit\MyGit\out\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "Z:\MyProjects_2026\MyGit\MyGit\out\libcrypto-3-x64.dll"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"

[Code]
procedure CurStepChanged(CurStep: TSetupStep);
var
  DataDir, LocalDir: String;
  ResultCode: Integer;
begin
  if CurStep = ssPostInstall then
  begin
    DataDir := ExpandConstant('{commonappdata}\{#MyAppName}');
    if ForceDirectories(DataDir) then
    begin
      if not FileExists(DataDir + '\users.db') then
        SaveStringToFile(DataDir + '\users.db', '', False);
      Exec('icacls.exe', '"' + DataDir + '\users.db" /grant *S-1-5-32-545:(OI)(CI)M', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    end;

    LocalDir := ExpandConstant('{localappdata}\{#MyAppName}');
    if ForceDirectories(LocalDir) then
    begin
      if not FileExists(LocalDir + '\session.dat') then
        SaveStringToFile(LocalDir + '\session.dat', '', False);
      Exec('icacls.exe', '"' + LocalDir + '\session.dat" /grant *S-1-5-11:(OI)(CI)M', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    end;
  end;
end;



